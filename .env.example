# Copy to .env and adjust. These are the only variables this app reads;
# the AI provider keys are NOT env vars — they are entered in the UI and stored
# by lib/actions/ai-config.ts.

# Port the server listens on (defaults to 3000).
AMPLE_PORT=

# SQLite database file. Defaults to a path under XDG_DATA_HOME (or APPDATA on Windows).
DB_FILE_NAME=

# Drizzle migrations directory. Defaults to the bundled one; override only for a custom build.
MIGRATIONS_DIR=
